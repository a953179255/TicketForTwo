<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- 中文名「双人票」是主名称，场景感强；英文名 TicketForTwo 用于仓库/包名/
         跨平台标识等 ASCII 场景。曾用 Ticket²（Ticket Squared，数学梗「快乐 ×2」），
         因上标 ² 在目录名、部分启动器标签、Git 仓库名里会出问题而弃用。 -->
    <string name="app_name">双人票</string>
    <string name="app_name_latin">TicketForTwo</string>
    <string name="app_slogan">两张票，一个厅，管它隔着几座城</string>

    <string name="notif_channel">屏幕分享</string>
    <!-- 仅语音那类前台服务（放映厅、只连麦）的通知：标题绝不能写"正在分享"，
         那时根本没投屏 —— 用户看到会以为屏幕已经在外传（实测反馈过一次）。 -->
    <string name="notif_channel_voice">语音</string>
    <string name="notif_voice_title">语音已连接</string>
    <string name="notif_voice_text">等对方加入，点停止立即结束</string>
    <string name="notif_voice_joined">1 人已加入</string>
    <string name="notif_sharing_title">正在分享给朋友</string>
    <string name="notif_sharing_text">对方能看到你的屏幕，点停止立即结束</string>
    <string name="notif_stop">停止</string>
</resources>

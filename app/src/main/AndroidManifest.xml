<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- 屏幕采集：Android 14 起每次会话都要重新弹授权 -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <!-- 仅语音模式：前台服务改用 microphone 类型（不申请投屏） -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <!-- 麦克风连麦 -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- 走 VOICE_COMMUNICATION 路由以启用平台 AEC -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- mediaProjection 前台服务的可见通知 -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- 分享期间锁屏会断流，需要保持亮屏 -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!-- 悬浮控制岛：自己的界面也会出现在分享画面里，这个开关后面要能关 -->
    <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.TicketForTwo">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:supportsPictureInPicture="true"
            android:configChanges="orientation|screenSize|smallestScreenSize|screenLayout|keyboardHidden|uiMode"
            android:theme="@style/Theme.TicketForTwo">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- 递链接入口：在任何浏览器里点「分享 → 双人票」，链接直接落进放映厅。
                 这条是 R1 的正解 —— 不去改造浏览器，也不要求用户换找片习惯，
                 只是把"复制→切 App→粘贴"这三步换成一次系统分享。 -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <!-- Android 14+：必须声明 mediaProjection 类型，且要在拿到授权之后、
             getMediaProjection() 之前启动，顺序错了直接抛异常。
             microphone 是仅语音模式用的类型，两种类型都必须在这里声明过才能 startForeground。 -->
        <service
            android:name=".ShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection|microphone" />

    </application>

</manifest>

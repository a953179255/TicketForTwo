# Gradle / AGP
.gradle/
build/
app/build/
.kotlin/

# 机器专属：含本机 sdk.dir，绝不入库
# 注意：gitignore 不支持行尾注释，注释必须独立成行
local.properties

# IDE
*.iml
.idea/
.navigation/
captures/

# 构建产物与签名
*.apk
*.aab
*.keystore
!debug.keystore
release-signing.properties
keystore.properties

# 系统 / 编辑器
.DS_Store
Thumbs.db
*.swp

# 原生构建中间物
.externalNativeBuild/
.cxx/

# 多 agent 共享调试暂存区，勿入库
.test-work/
tmp/

# 本地调试产物：一次性邀请链接（含真实 SDP 与候选地址）、统计回传
# 统一放 .dev/ —— viewer/public 是会被打包上传的站点根，绝不能落在那儿
.dev/
# uiautomator dump 落在**仓库根**（drive_m0.py 的 cwd），写成 viewer/ 下就永远匹配不上
ui_dump.xml
